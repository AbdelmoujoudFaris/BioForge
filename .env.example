# Copy to .env and fill in what you actually have. Every field has a safe
# default/graceful fallback (see src/bioforge/common/config.py) - BioForge
# runs with none of these set.

# Service discovery (defaults match docker-compose.yml)
BIOFORGE_GATEWAY_URL=http://localhost:8000
BIOFORGE_STRUCTURE_SERVICE_URL=http://localhost:8001
BIOFORGE_GENERATE_SERVICE_URL=http://localhost:8002
BIOFORGE_REFINE_SERVICE_URL=http://localhost:8003
BIOFORGE_RETRIEVAL_SERVICE_URL=http://localhost:8004
BIOFORGE_ADMET_SERVICE_URL=http://localhost:8005
BIOFORGE_MECHANISM_SERVICE_URL=http://localhost:8006
BIOFORGE_REPORT_SERVICE_URL=http://localhost:8007
BIOFORGE_ORCHESTRATOR_SERVICE_URL=http://localhost:8008

# Message queue / distributed compute (optional - degrades to in-process)
BIOFORGE_REDIS_URL=redis://localhost:6379/0
BIOFORGE_CELERY_BROKER_URL=redis://localhost:6379/0

# Provenance (optional - falls back to a local .provenance/*.jsonl log)
# BIOFORGE_MLFLOW_TRACKING_URI=http://localhost:5000

# Mechanistic hypothesis narrative generation (optional - falls back to an
# offline, deterministic template writer using the real computed causal
# chain/pathway/literature data; no API key required for that path)
# BIOFORGE_LLM_PROVIDER=anthropic
# BIOFORGE_LLM_API_KEY=sk-ant-...

# DrugBank requires a commercial data license - without a key, retrieval
# returns a small labeled bundled sample instead of live DrugBank data.
# BIOFORGE_DRUGBANK_API_KEY=
